{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build for Simulation",
            "dependsOn": [
                "Close Playdate Simulator"
            ],
            "dependsOrder": "sequence",
            "type": "shell",
            "command": "${workspaceFolder}\\buildSim.bat",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds the project in the build folder using CMake and NMake in the VS Dev Environment"
        },
        {
            "label": "Clean Build for Device",
            "type": "shell",
            "command": "${workspaceFolder}\\buildDevice.bat",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Builds the project in the build folder using CMake and NMake in the VS Dev Environment"
        },
        {
            "label": "Simulate Build",
            "type": "shell",
            "command": "PlaydateSimulator.exe ${workspaceFolder}.pdx",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Runs the latest build in the simulator."
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-Command",
                "if (Test-Path build_sim) { Remove-Item -Recurse build_sim}; Get-ChildItem -Directory -Filter '*.pdx' | ForEach-Object { Remove-Item -Recurse -Force $_.FullName }"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Removes the build folder and any folder with the extension .pdx"
        },
        {
            "label": "Close Playdate Simulator",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "$simulator = @(Get-Process -Name 'PlaydateSimulator' -ErrorAction SilentlyContinue);if ($simulator.Count -gt 0) { $simulator | Stop-Process -Force }; exit 0"
            ],
            "problemMatcher": []
        },
        {
            "label": "Clean Build for Simulation",
            "dependsOn": [
                "Close Playdate Simulator",
                "Clean",
                "Build for Simulation"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}